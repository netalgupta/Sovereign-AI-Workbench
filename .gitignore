__pycache__/
*.pyc
.pytest_cache/
.claude/
.venv/
venv/
*.egg-info/
node_modules/
dist/
build/
.env
*.log

# Model weights and portable-drive artifacts never belong in git — these
# are fetched once via backend/ingestion/fetch_models.py (see model_cache.py)
# and shipped on the portable drive per DEPENDENCIES.md §10, never checked in.
*.gguf
*.tar
*.safetensors
*.bin
*.onnx
/models/weights/
/models/embeddings/
/models/ocr/
/models/vision/
/models/audio/
*.zip

# Automated UI test & screenshot capture profiles
edge_*_profile/
edge_temp_*/
.temp_edge*/
capture*.js
test_theme.js
screenshots/

# Frontend pipeline snapshots: regenerate with
#   python -m backend.evaluation.export_frontend_assets
# images.json in particular is multi-MB of base64 chart images, derived
# entirely from files already tracked in the corpus directories.
frontend/public/pipeline/images.json

# Runtime stores: image pixels extracted from documents, the registry of
# where the user's source files live, and the ingestion queue. All are
# machine-local state derived from the user's own filesystem, and the
# registry in particular contains absolute paths from their machine.
image_store/
document_registry/

# Audit trail and approval queue: machine-local records of what this
# install did and who approved it. Never shared between machines — an
# audit log is evidence about one deployment, not project source.
/audit/
backend/audit/*.jsonl


# Built standalone console: ~3.4MB of base64 images derived entirely from
# files already tracked in the corpus directories. Regenerate with
#   python frontend/standalone/build_console.py
frontend/standalone/workbench_console.html

# Watched-source config: absolute paths from ONE machine. It was
# committed with another developer's checkout baked in
# (C:\SIH\..., plus two unrelated personal projects indexed during
# testing), which pointed every default at a directory that does not
# exist here. Machine-local state, like document_registry/ and audit/.
backend/evaluation/configured_sources.json

backend/memory/*.db
